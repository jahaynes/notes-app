cabal-version:      3.4
name:               notes-app-backend
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             John Haynes
maintainer:         jahaynes@users.noreply.github.com
build-type:         Simple

common common
    ghc-options: -Wall -O2
    default-extensions:
        DeriveFunctor
        GeneralizedNewtypeDeriving
        InstanceSigs
        LambdaCase
        OverloadedStrings
        QuasiQuotes
        ScopedTypeVariables
    build-depends:
        aeson,
        base,
        bytestring,
        containers,
        http-api-data,
        lens,
        openapi3,
        safe-exceptions,
        servant,
        servant-openapi3,
        servant-server,
        servant-swagger-ui,
        sqlite-simple,
        string-interpolate,
        text,
        time,
        transformers,
        uuid,
        vector,
        wai,
        wai-cors,
        warp

library
    import:           common
    exposed-modules:  Controller
                      NotesApp
                      NoteStore.Class
                      NoteStore.SQLite.NoteStoreSQLite
                      NoteStore.SQLite.SQLiteTypes 
                      Types
    hs-source-dirs:   src
    default-language: Haskell2010

executable notes-app-backend
    import:           common
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        base,
        notes-app-backend
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite notes-app-backend-test
    import:           common
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Test.hs
    other-modules:    NoteStorePure
    build-depends:
        base,
        hspec,
        notes-app-backend
