cabal-version:      3.4
name:               notes-app-backend
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             John Haynes
maintainer:         jahaynes@users.noreply.github.com
build-type:         Simple

common warnings
    ghc-options: -Wall -O2

library
    import:           warnings
    exposed-modules:  MyLib
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable notes-app-backend
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base,
        notes-app-backend
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite notes-app-backend-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Test.hs
    build-depends:
        base,
        notes-app-backend
